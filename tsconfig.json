{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "noEmit": true,
        "types": ["node"],
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "allowJs": true
    },
    "include": ["src", "vite.config.ts"]
}
