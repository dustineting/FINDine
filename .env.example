# MongoDB Atlas connection. Copy this file to .env and fill in your credentials.
# Leave unset to use the server JSON fallback.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/restaurants_db?appName=Cluster0

# Optional comma-separated DNS servers if the system resolver cannot look up Atlas.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Run npm run admin:setup locally to generate these values without exposing the password.
# Add the same three values to Vercel's environment variables to enable admin login.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Vite defaults to 8443; the standalone API defaults to 5000.
# PORT=

# Vite bind address is configured through the shell environment.
# HOST defaults to 127.0.0.1; set HOST=0.0.0.0 for local-network access.
