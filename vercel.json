{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/index.js": {
            "includeFiles": "server/data/restaurants.json",
            "maxDuration": 30
        }
    },
    "rewrites": [{ "source": "/api/:path*", "destination": "/api" }]
}
